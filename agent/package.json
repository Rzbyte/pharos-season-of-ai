{
  "name": "pharos-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Pharos Agent Lab: the agent runtime behind Tasks 05 to 30 (Pharos Chain MCP, Developer Docs MCP, Skill Engine, x402)",
  "type": "module",
  "bin": {
    "pharos-agent": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p vendor/pharos-mcp && tsc",
    "prepare": "npm run build",
    "start": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "viem": "2.57.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
